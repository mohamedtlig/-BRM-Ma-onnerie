<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"] | Administration BRM</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <div class="admin-shell">
        <aside class="admin-sidebar">
            <div class="admin-sidebar__brand">
                BRM <span>Administration</span>
            </div>
            <nav class="admin-nav">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> Tableau de bord
                </a>
                <a asp-area="Admin" asp-controller="QuoteRequests" asp-action="Index">
                    <i class="bi bi-file-earmark-text"></i> Demandes de devis
                </a>
                <a asp-area="Admin" asp-controller="Services" asp-action="Index">
                    <i class="bi bi-tools"></i> Services &amp; tarifs
                </a>
                <a asp-area="Admin" asp-controller="Projects" asp-action="Index">
                    <i class="bi bi-images"></i> Réalisations
                </a>
                <a asp-area="" asp-controller="Home" asp-action="Index" target="_blank">
                    <i class="bi bi-box-arrow-up-right"></i> Voir le site
                </a>
            </nav>
            <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post" class="admin-sidebar__logout">
                <button type="submit" class="btn btn-outline-light btn-sm w-100">
                    <i class="bi bi-box-arrow-right"></i> Se déconnecter
                </button>
            </form>
        </aside>

        <div class="admin-content">
            <main class="p-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
