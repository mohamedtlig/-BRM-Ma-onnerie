@{
    var code = (int)(ViewData["StatusCode"] ?? 500);
    var message = code == 404
        ? "La page que vous recherchez n'existe pas ou plus."
        : "Une erreur est survenue lors du traitement de votre demande.";
}

<section class="section text-center">
    <div class="container">
        <p class="hero-badge">Erreur @code</p>
        <h1 class="section-title">@ViewData["Title"]</h1>
        <p class="text-muted">@message</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-brand-primary mt-3">Retour à l'accueil</a>
    </div>
</section>
