@model ErrorViewModel
@{
    ViewData["Title"] = "Une erreur est survenue";
}

<section class="section text-center">
    <div class="container">
        <h1 class="section-title">Une erreur est survenue</h1>
        <p class="text-muted">
            Nous sommes désolés, une erreur inattendue s'est produite lors du traitement de votre demande.
        </p>

        @if (Model.ShowRequestId)
        {
            <p class="small text-muted">Référence technique : <code>@Model.RequestId</code></p>
        }

        <a asp-controller="Home" asp-action="Index" class="btn btn-brand-primary mt-3">Retour à l'accueil</a>
    </div>
</section>
