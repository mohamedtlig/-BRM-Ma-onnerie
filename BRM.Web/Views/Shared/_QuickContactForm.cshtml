@model BRM.Web.ViewModels.Contact.ContactFormViewModel

<section class="section section-alt">
    <div class="container" style="max-width: 700px;">
        <p class="section-title-eyebrow text-center">Contact rapide</p>
        <h2 class="section-title text-center mb-4">Une question avant de vous lancer ?</h2>

        @if (TempData["ContactSuccess"] != null)
        {
            <div class="alert alert-success">@TempData["ContactSuccess"]</div>
        }

        <div class="form-card">
            <form asp-controller="Contact" asp-action="Index" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Nom" class="form-label"></label>
                        <input asp-for="Nom" class="form-control" />
                        <span asp-validation-for="Nom" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="Message" class="form-label"></label>
                    <textarea asp-for="Message" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Message" class="text-danger small"></span>
                </div>
                <div class="form-check mb-3">
                    <input asp-for="ConsentementRGPD" class="form-check-input" />
                    <label asp-for="ConsentementRGPD" class="form-check-label small"></label>
                    <span asp-validation-for="ConsentementRGPD" class="text-danger small d-block"></span>
                </div>
                <button type="submit" class="btn btn-brand-primary">Envoyer</button>
            </form>
        </div>
    </div>
</section>
